{
  "name": "ghost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ghost Linear agent service",
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/muse-output-schema.json dist/muse-output-schema.json && cp src/chat-gate-schema.json dist/chat-gate-schema.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test --test-reporter=spec test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18"
  }
}
